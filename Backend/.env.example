PORT=5000
MONGO_URI=mongodb://localhost:27017/datarheo
JWT_SECRET=replace-with-at-least-32-random-characters
# Add every frontend origin that calls the API, comma-separated.
FRONTEND_URL=http://localhost:5173
RESET_PASSWORD_URL=http://localhost:5173/reset-password
# Keep empty for local development. Use .datarheo.io in production so app.datarheo.io
# receives the HttpOnly session cookies set by api.datarheo.io.
COOKIE_DOMAIN=
REDIS_URL=
REDIS_REQUIRED=false
METRICS_TOKEN=864a7f5c19412637e2b6b24c791e4339e9fae31bc67a080a92a21f9516ba3466
TRUST_PROXY=1
NODE_ENV=development
LOG_LEVEL=info
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
EMAIL_USER=replace-with-smtp-user
EMAIL_PASSWORD=replace-with-smtp-password
